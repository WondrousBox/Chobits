{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.chobits.ai",
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*",
    "node_modules/sqlite-vec/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/sharp-*/**/*",
    "node_modules/@img/sharp-libvips-*/**/*"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "node_modules/better-sqlite3/**/*",
    "node_modules/sqlite-vec/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/sharp-*/**/*",
    "node_modules/@img/sharp-libvips-*/**/*"
  ],
  "extraResources": [
    {
      "from": "drizzle",
      "to": "./drizzle"
    },
    {
      "from": "resources/providers",
      "to": "./providers"
    },
    {
      "from": "resources/ffmpeg/${platform}/${arch}",
      "to": "./ffmpeg/${platform}/${arch}"
    },
    {
      "from": "resources/sprites",
      "to": "./sprites"
    },
    {
      "from": "resources/recorder/${platform}/${arch}",
      "to": "./recorder/${platform}/${arch}"
    },
    {
      "from": "resources/yt-dlp/${platform}/",
      "to": "./yt-dlp/${platform}/"
    }
  ],
  "mac": {
    "artifactName": "${productName}_${version}_${platform}_${arch}.${ext}",
    "target": [
      "dmg",
      "zip"
    ],
    "icon": "build/icons/icon.icns",
    "entitlements": "public/entitlements.plist",
    "entitlementsInherit": "public/entitlements.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "Please allow this program to access your microphone",
      "NSCameraUsageDescription": "Please allow this program to access your camera",
      "NSSpeechRecognitionUsageDescription": "Please allow this program to access speech recognition service",
      "NSScreenCaptureUsageDescription": "Please allow this program to record the screen"
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}_${platform}_${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "generic",
    "channel": "latest",
    "url": "https://github.com/electron-vite/chobits/releases/download/v0.0.1/"
  }
}