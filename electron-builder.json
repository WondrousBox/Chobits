{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.chobits.ai",
  "asar": true,
  "asarUnpack": ["node_modules/better-sqlite3/**/*", "node_modules/sharp/**/*", "node_modules/@img/sharp-*/**/*", "node_modules/@img/sharp-libvips-*/**/*", "node_modules/sherpa-onnx-node/**/*", "node_modules/uiohook-napi/**/*"],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist",
    "node_modules/better-sqlite3/**/*",
    "node_modules/sharp/**/*",
    "node_modules/@img/sharp-*/**/*",
    "node_modules/@img/sharp-libvips-*/**/*",
    "node_modules/sherpa-onnx-node/**/*",
    "node_modules/uiohook-napi/**/*"
  ],
  "extraResources": [
    {
      "from": "drizzle",
      "to": "./drizzle"
    },
    {
      "from": "resources/providers",
      "to": "./providers"
    },
    {
      "from": "resources/characters",
      "to": "./characters"
    },
    {
      "from": "resources/sherpa",
      "to": "./sherpa"
    },
    {
      "from": "resources/plugins",
      "to": "./plugins"
    },
    {
      "from": "resources/7zip/${platform}/${arch}",
      "to": "./7zip/${platform}/${arch}"
    },
    {
      "from": "resources/html",
      "to": "./html"
    }
  ],
  "linux": {
    "artifactName": "${productName}_${version}_${platform}_${arch}.${ext}",
    "target": ["AppImage", "deb"],
    "category": "Utility",
    "icon": "build/icons"
  },
  "mac": {
    "artifactName": "${productName}_${version}_${platform}_${arch}.${ext}",
    "target": ["dmg", "zip"],
    "icon": "build/icons/icon.icns",
    "entitlements": "build/entitlements.plist",
    "entitlementsInherit": "build/entitlements.plist",
    "extendInfo": {
      "NSMicrophoneUsageDescription": "此应用需要访问麦克风以进行音频录制"
    }
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icons/icon.ico",
    "artifactName": "${productName}_${version}_${platform}_${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/icons/icon.ico",
    "uninstallerIcon": "build/icons/icon.ico"
  },
  "publish": {
    "provider": "github",
    "owner": "chenxin199305",
    "repo": "Chobits-Chi-Mascot",
    "channel": "latest"
  }
}
