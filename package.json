{
  "name": "chobits",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "Electron Vite React boilerplate.",
  "author": "Yu <yuqian.124@gmail.com>",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:rebuild": "pnpm rebuild && pnpm build",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "rebuild:sqlite-vec": "electron-rebuild -f -w sqlite-vec",
    "rebuild": "node scripts/rebuild-native.js",
    "download-ffmpeg-darwin-arm64": "mkdir -p resources/ffmpeg/darwin/arm64 && cd resources/ffmpeg/darwin/arm64 && wget https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffmpeg-macos-ARM64 -O ffmpeg && wget https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffprobe-macos-ARM64 -O ffprobe && chmod +x ffmpeg && chmod +x ffprobe",
    "download-ffmpeg-win32-x64": "mkdirp resources/ffmpeg/win32/x64 && cd resources/ffmpeg/win32/x64 && npx download-cli https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffmpeg.exe --out . --filename ffmpeg.exe && npx download-cli https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffprobe.exe --out . --filename ffprobe.exe",
    "download-ytdlp-win32": "mkdirp resources/yt-dlp/win32 && cd resources/yt-dlp/win32 && npx download-cli https://github.com/yt-dlp/yt-dlp/releases/download/2025.09.05/yt-dlp.exe --out . --filename yt-dlp.exe",
    "download-ytdlp-darwin": "mkdir -p resources/yt-dlp/darwin && cd resources/yt-dlp/darwin && wget https://github.com/yt-dlp/yt-dlp/releases/download/2025.09.05/yt-dlp_macos.zip -O yt-dlp.zip && unzip yt-dlp.zip && rm yt-dlp.zip",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.3",
    "@img/sharp-libvips-win32-x64": "1.2.3",
    "@img/sharp-win32-x64": "0.34.4",
    "better-sqlite3": "^12.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "electron-updater": "^6.3.9",
    "fluent-ffmpeg": "^2.1.3",
    "keytar": "^7.9.0",
    "lucide-react": "^0.537.0",
    "react-i18next": "^15.7.3",
    "sharp": "^0.34.4",
    "sqlite-vec": "0.1.7-alpha.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@google/generative-ai": "^0.24.1",
    "@anthropic-ai/sdk": "^0.67.0",
    "@langchain/community": "^0.3.57",
    "@langchain/core": "^0.3.78",
    "@langchain/openai": "^0.6.16",
    "@playwright/test": "^1.48.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^24.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "anthropic": "^0.0.0",
    "autoprefixer": "^10.4.20",
    "dayjs": "^1.11.18",
    "drizzle-kit": "^0.31.4",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "electron-log": "^5.4.3",
    "framer-motion": "^12.23.12",
    "https-proxy-agent": "^7.0.6",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.0",
    "sass": "^1.92.1",
    "socks-proxy-agent": "^8.0.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.5",
    "zod": "^4.1.12"
  }
}