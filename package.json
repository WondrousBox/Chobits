{
  "name": "Chobits",
  "version": "1.0.0",
  "productName": "Chobits",
  "main": "dist-electron/main/index.js",
  "description": "你的 AI 桌面精灵、助手、工具。 An AI desktop assistant and tool developed with Electron.",
  "author": "Yu <yuqu.2233@gmail.com>",
  "contributors": [
    {
      "name": "JasonChen",
      "email": "chenxin199305@163.com"
    }
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node -e \"if (process.platform === 'win32') process.exit(1)\" || chcp 65001 && vite",
    "dev:fresh-voice": "node scripts/clean-speak-cache.js && pnpm dev",
    "build": "tsc && vite build && electron-builder",
    "release": "tsc && vite build && electron-builder --publish always",
    "postinstall": "electron-builder install-app-deps",
    "build:rebuild": "pnpm rebuild && pnpm build",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "lint": "eslint --cache . && node scripts/check-boundaries.mjs",
    "clean:speak-cache": "node scripts/clean-speak-cache.js",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "rebuild": "node scripts/rebuild-native.js",
    "download-7zip": "node scripts/download-7zip.mjs",
    "download-7zip-darwin-arm64": "node scripts/download-7zip.mjs darwin arm64",
    "download-7zip-darwin-x64": "node scripts/download-7zip.mjs darwin x64",
    "download-7zip-linux-x64": "node scripts/download-7zip.mjs linux x64",
    "download-7zip-win32-x64": "node scripts/download-7zip.mjs win32 x64",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:permissions": "node scripts/check-permissions.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.80.2",
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@earendil-works/pi-tui": "^0.80.2",
    "better-sqlite3": "^12.5.0",
    "electron-updater": "^6.8.9",
    "keytar": "^7.9.0",
    "openai": "^7.8.0",
    "sharp": "^0.35.0",
    "sherpa-onnx-node": "^1.13.2",
    "uiohook-napi": "^1.5.5",
    "undici": "^8.10.0",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-win32-x64": "1.3.3",
    "@img/sharp-win32-x64": "0.35.4"
  },
  "devDependencies": {
    "@aim-packages/downloader": "0.2.0",
    "@aim-packages/file-utils": "^0.2.0",
    "@aim-packages/window-manager": "^0.5.3",
    "@anthropic-ai/sdk": "^0.67.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron/rebuild": "^4.2.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash-es": "^4.17.12",
    "@types/mustache": "^4.2.6",
    "@types/node": "^24.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ahooks": "^3.9.7",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dayjs": "^1.11.18",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.3",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "framer-motion": "^12.23.12",
    "highlight.js": "^11.11.1",
    "https-proxy-agent": "^7.0.6",
    "lodash-es": "^4.17.21",
    "lucide-react": "^0.537.0",
    "mustache": "^4.2.0",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "prettier": "^3.6.2",
    "pretty-bytes": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.9.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sass": "^1.92.1",
    "socks-proxy-agent": "^8.0.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.170.0",
    "typebox": "^1.1.38",
    "typescript": "^5.4.2",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.2.6",
    "zod": "^4.1.12"
  }
}
