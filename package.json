{
  "name": "Chobits",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "你的 AI 桌面精灵、助手、工具。 An AI desktop assistant and tool developed with Electron.",
  "author": "Yu <yuqu.2233@gmail.com>",
  "license": "MIT",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "node -e \"if (process.platform === 'win32') process.exit(1)\" || chcp 65001 && vite",
    "build": "tsc && vite build && electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "build:rebuild": "pnpm rebuild && pnpm build",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "lint": "eslint --cache .",
    "build:icon": "electron-icon-builder --input=./build/icon.png --output=./build --flatten",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "rebuild:sqlite-vec": "electron-rebuild -f -w sqlite-vec",
    "rebuild": "node scripts/rebuild-native.js",
    "download-ffmpeg-darwin-arm64": "mkdir -p resources/ffmpeg/darwin/arm64 && cd resources/ffmpeg/darwin/arm64 && wget https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffmpeg-macos-ARM64 -O ffmpeg && wget https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffprobe-macos-ARM64 -O ffprobe && chmod +x ffmpeg && chmod +x ffprobe",
    "download-ffmpeg-win32-x64": "mkdirp resources/ffmpeg/win32/x64 && cd resources/ffmpeg/win32/x64 && npx download-cli https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffmpeg.exe --out . --filename ffmpeg.exe && npx download-cli https://github.com/YuQian2015/memo-build/releases/download/v1.0.0/ffprobe.exe --out . --filename ffprobe.exe",
    "download-ytdlp-win32": "mkdirp resources/yt-dlp/win32 && cd resources/yt-dlp/win32 && npx download-cli https://github.com/yt-dlp/yt-dlp/releases/download/2025.10.14/yt-dlp.exe --out . --filename yt-dlp.exe",
    "download-ytdlp-darwin": "mkdir -p resources/yt-dlp/darwin && cd resources/yt-dlp/darwin && wget https://github.com/yt-dlp/yt-dlp/releases/download/2025.10.14/yt-dlp_macos.zip -O yt-dlp.zip && unzip yt-dlp.zip && rm yt-dlp.zip",
    "download-bun-darwin-x64": "node scripts/downloadBun.js darwin x64",
    "download-bun-darwin-arm64": "node scripts/downloadBun.js darwin arm64",
    "download-bun-win32-x64": "node scripts/downloadBun.js win32 x64",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check:permissions": "node scripts/check-permissions.mjs"
  },
